# Copy to .env (one level above BackEnd and FrontEnd). Never commit .env.
NODE_ENV=development
PORT=4200
DATABASE_URL=postgresql://raaaa_app:CHANGE_ME@localhost:5432/raaaa
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Optional: BTN catalog database logins (the portal still starts without them).
# Read-only login for the sale barns list:
BARNS_DATABASE_URL=
# Login that may update sale barn contact details:
BARNS_WRITE_DATABASE_URL=
# Login for pick lists (breeds, programs, vaccine products, auction markets, EPD traits),
# zip codes for distance search, and adding vaccine products / auction markets:
REF_DATABASE_URL=

# Optional: the data sheet PDF. These have working defaults, so leave them out unless needed.
# Where wkhtmltopdf is installed (default on the server: C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe):
WKHTMLTOPDF_PATH=
# This site's address, used for the QR code on the data sheet:
SITE_URL=
# Logo file for the top of the data sheet (default: BackEnd/assets/raaa-logo.svg):
DATASHEET_LOGO_PATH=
